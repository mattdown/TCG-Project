<mxfile host="drawio"><diagram name="system_overview" id="system_overview"><mxGraphModel grid="1" gridSize="10" page="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="system_overview-1" value="TCG-Project: rules engine, state graph, model, self-play and card generation" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=20;fontStyle=1;fontColor=#1f1f1e;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1200" height="30" as="geometry"/></mxCell><mxCell id="system_overview-2" value="Card definitions (pure data)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#efeafb;strokeColor=#7b5cd6;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontFamily=Helvetica;fontSize=15;fontStyle=1;fontColor=#1f1f1e;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="400" height="540" as="geometry"/></mxCell><mxCell id="system_overview-3" value="&lt;b style=&quot;font-size:14px&quot;&gt;Starter set&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;~30–60 cards written by hand;&lt;br&gt;engine test fixtures and a sanity anchor&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7b5cd6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="360" height="80" as="geometry"/></mxCell><mxCell id="system_overview-4" value="&lt;b style=&quot;font-size:14px&quot;&gt;Typed ability DSL&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;building blocks with types and value ranges;&lt;br&gt;a renderer turns every tree into card text&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7b5cd6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="205" width="360" height="80" as="geometry"/></mxCell><mxCell id="system_overview-5" value="&lt;b style=&quot;font-size:14px&quot;&gt;Card definition (one JSON schema)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;&lt;div style='text-align:left;margin-top:6px'&gt;• &lt;b&gt;Stats&lt;/b&gt; → feature vector: type, aspects,&lt;br&gt;&amp;nbsp;&amp;nbsp;energy source, cost, power, health, score, traits&lt;br&gt;• &lt;b&gt;Keywords&lt;/b&gt; → parameter features: Charge, Elusive,&lt;br&gt;&amp;nbsp;&amp;nbsp;Guard, Duelist +N, Armor +N, Evolve N, …&lt;br&gt;• &lt;b&gt;Abilities&lt;/b&gt; → DSL trees: trigger · cost · condition&lt;br&gt;&amp;nbsp;&amp;nbsp;· effect · target selector · filter&lt;/div&gt;&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7b5cd6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="360" height="170" as="geometry"/></mxCell><mxCell id="system_overview-6" value="&lt;b style=&quot;font-size:14px&quot;&gt;Generated cards&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;written by part c in the same schema&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7b5cd6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="360" height="80" as="geometry"/></mxCell><mxCell id="system_overview-7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="system_overview-3" target="system_overview-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="system_overview-8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="system_overview-4" target="system_overview-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="system_overview-9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="system_overview-6" target="system_overview-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="system_overview-10" value="Rules engine (Python, symbolic)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#e6effb;strokeColor=#2a78d6;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontFamily=Helvetica;fontSize=15;fontStyle=1;fontColor=#1f1f1e;" vertex="1" parent="1"><mxGeometry x="480" y="60" width="400" height="540" as="geometry"/></mxCell><mxCell id="system_overview-11" value="&lt;b style=&quot;font-size:14px&quot;&gt;Game state&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;zones, energy, victory points, damage,&lt;br&gt;exhausted / fresh, active effects with durations&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2a78d6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="500" y="110" width="360" height="80" as="geometry"/></mxCell><mxCell id="system_overview-12" value="&lt;b style=&quot;font-size:14px&quot;&gt;Turn structure&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;ready → set → draw → main → end;&lt;br&gt;first to 20 VP wins, empty deck loses&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2a78d6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="500" y="205" width="360" height="80" as="geometry"/></mxCell><mxCell id="system_overview-13" value="&lt;b style=&quot;font-size:14px&quot;&gt;DSL interpreter&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;runs the card definitions: triggers, costs,&lt;br&gt;conditions, effects, durations&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2a78d6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="500" y="300" width="360" height="80" as="geometry"/></mxCell><mxCell id="system_overview-14" value="&lt;b style=&quot;font-size:14px&quot;&gt;Legal actions &amp;amp; choices&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;add energy, play, evolve, chant, score, duel,&lt;br&gt;move, activate, then one decision per target&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2a78d6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="500" y="395" width="360" height="80" as="geometry"/></mxCell><mxCell id="system_overview-15" value="&lt;b style=&quot;font-size:14px&quot;&gt;Environment API&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;reset · legal_actions · step · observe(player)&lt;br&gt;· clone · determinize&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2a78d6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="500" y="490" width="360" height="80" as="geometry"/></mxCell><mxCell id="system_overview-16" value="card defs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;exitX=1;exitY=0.28;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="system_overview-5" target="system_overview-13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="system_overview-17" value="Graph builder (observation → graph)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fdece5;strokeColor=#eb6834;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontFamily=Helvetica;fontSize=15;fontStyle=1;fontColor=#1f1f1e;" vertex="1" parent="1"><mxGeometry x="940" y="60" width="400" height="540" as="geometry"/></mxCell><mxCell id="system_overview-18" value="&lt;b style=&quot;font-size:14px&quot;&gt;Card-instance nodes&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;card embedding + dynamic state: zone, exhausted,&lt;br&gt;damage, fresh, site, modifiers&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#eb6834;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="960" y="110" width="360" height="80" as="geometry"/></mxCell><mxCell id="system_overview-19" value="&lt;b style=&quot;font-size:14px&quot;&gt;Ability subgraph nodes&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;ability · trigger · cost · condition · effect&lt;br&gt;· selector · filter, each with parameters&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#eb6834;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="960" y="205" width="360" height="80" as="geometry"/></mxCell><mxCell id="system_overview-20" value="&lt;b style=&quot;font-size:14px&quot;&gt;Player, global &amp;amp; effect nodes&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;VP, energy, hand/deck size, turn, phase;&lt;br&gt;active effects (e.g. “can’t ready next turn”)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#eb6834;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="960" y="300" width="360" height="80" as="geometry"/></mxCell><mxCell id="system_overview-21" value="&lt;b style=&quot;font-size:14px&quot;&gt;Edges&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;static: has_ability, ability structure, same_name&lt;br&gt;dynamic: in_zone, at_site, evolved_from,&lt;br&gt;matches (filter → card), affects (effect → card)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#eb6834;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="960" y="395" width="360" height="80" as="geometry"/></mxCell><mxCell id="system_overview-22" value="&lt;b style=&quot;font-size:14px&quot;&gt;Hidden information&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;one graph per player: opponent’s hand and deck&lt;br&gt;are counts only, no card nodes&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#eb6834;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="960" y="490" width="360" height="80" as="geometry"/></mxCell><mxCell id="system_overview-23" value="observe()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="system_overview-10" target="system_overview-17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="system_overview-24" value="Model (PyTorch Geometric)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#e3f6ef;strokeColor=#1baf7a;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontFamily=Helvetica;fontSize=15;fontStyle=1;fontColor=#1f1f1e;" vertex="1" parent="1"><mxGeometry x="1400" y="60" width="400" height="540" as="geometry"/></mxCell><mxCell id="system_overview-25" value="&lt;b style=&quot;font-size:14px&quot;&gt;Card encoder&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;stats + keywords + ability subgraph&lt;br&gt;→ card embedding, cached per card&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1baf7a;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="1420" y="110" width="360" height="80" as="geometry"/></mxCell><mxCell id="system_overview-26" value="&lt;b style=&quot;font-size:14px&quot;&gt;State encoder&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;heterogeneous GNN (or entity transformer)&lt;br&gt;over the whole state graph&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1baf7a;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="1420" y="205" width="360" height="80" as="geometry"/></mxCell><mxCell id="system_overview-27" value="&lt;b style=&quot;font-size:14px&quot;&gt;Policy head&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;scores each legal action from the embeddings&lt;br&gt;of the nodes it refers to (actor, target)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1baf7a;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="1420" y="300" width="360" height="80" as="geometry"/></mxCell><mxCell id="system_overview-28" value="&lt;b style=&quot;font-size:14px&quot;&gt;Value head&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;win probability; auxiliary: VP difference,&lt;br&gt;turns remaining&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1baf7a;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="1420" y="395" width="360" height="80" as="geometry"/></mxCell><mxCell id="system_overview-29" value="&lt;b style=&quot;font-size:14px&quot;&gt;Cost model&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;predicts a card’s fair cost from its embedding;&lt;br&gt;no per-card IDs, so it works on new cards&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1baf7a;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="1420" y="490" width="360" height="80" as="geometry"/></mxCell><mxCell id="system_overview-30" value="graphs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="system_overview-17" target="system_overview-24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="system_overview-31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="system_overview-25" target="system_overview-26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="system_overview-32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="system_overview-26" target="system_overview-27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="system_overview-33" value="c. Card set generation" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#8a8a85;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontFamily=Helvetica;fontSize=15;fontStyle=1;fontColor=#1f1f1e;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="20" y="650" width="880" height="300" as="geometry"/></mxCell><mxCell id="system_overview-34" value="&lt;b style=&quot;font-size:14px&quot;&gt;Accepted set (~3000 cards)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;joins the card pool&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a8a85;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="260" height="80" as="geometry"/></mxCell><mxCell id="system_overview-35" value="&lt;b style=&quot;font-size:14px&quot;&gt;Balance &amp;amp; interest metrics&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;win rate when played, inclusion rate,&lt;br&gt;archetypes, decision entropy, comebacks&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a8a85;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="330" y="700" width="260" height="80" as="geometry"/></mxCell><mxCell id="system_overview-36" value="&lt;b style=&quot;font-size:14px&quot;&gt;Simulated tournaments&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;trained agents + deckbuilder&lt;br&gt;play the candidate set&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a8a85;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="620" y="700" width="260" height="80" as="geometry"/></mxCell><mxCell id="system_overview-37" value="&lt;b style=&quot;font-size:14px&quot;&gt;Effect generator&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;grammar-constrained sampling, or an LLM&lt;br&gt;with grammar-constrained decoding&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a8a85;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="840" width="260" height="80" as="geometry"/></mxCell><mxCell id="system_overview-38" value="&lt;b style=&quot;font-size:14px&quot;&gt;Validity check&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;types and ranges hold; in simulated games&lt;br&gt;it does something and never loops&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a8a85;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="330" y="840" width="260" height="80" as="geometry"/></mxCell><mxCell id="system_overview-39" value="&lt;b style=&quot;font-size:14px&quot;&gt;Auto-costing&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;the cost model sets cost and stats,&lt;br&gt;so the generator never has to&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a8a85;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="620" y="840" width="260" height="80" as="geometry"/></mxCell><mxCell id="system_overview-40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="system_overview-37" target="system_overview-38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="system_overview-41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="system_overview-38" target="system_overview-39"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="system_overview-42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="system_overview-39" target="system_overview-36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="system_overview-43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="system_overview-36" target="system_overview-35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="system_overview-44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="system_overview-35" target="system_overview-34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="system_overview-45" value="revise" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="system_overview-35" target="system_overview-37"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="460" y="810"/><mxPoint x="170" y="810"/></Array></mxGeometry></mxCell><mxCell id="system_overview-46" value="new cards" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="system_overview-34" target="system_overview-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="system_overview-47" value="b. Self-play training" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#8a8a85;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontFamily=Helvetica;fontSize=15;fontStyle=1;fontColor=#1f1f1e;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="960" y="650" width="840" height="300" as="geometry"/></mxCell><mxCell id="system_overview-48" value="&lt;b style=&quot;font-size:14px&quot;&gt;Checkpoints &amp;amp; league&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;past versions as opponents; evaluation&lt;br&gt;against hand-written heuristic agents&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a8a85;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="985" y="700" width="370" height="80" as="geometry"/></mxCell><mxCell id="system_overview-49" value="&lt;b style=&quot;font-size:14px&quot;&gt;Actors&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;many engine instances in parallel,&lt;br&gt;batched GPU inference&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a8a85;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="1405" y="700" width="370" height="80" as="geometry"/></mxCell><mxCell id="system_overview-50" value="&lt;b style=&quot;font-size:14px&quot;&gt;Learner&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;PPO with action masking first;&lt;br&gt;AlphaZero-style determinized search later&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a8a85;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="985" y="840" width="370" height="80" as="geometry"/></mxCell><mxCell id="system_overview-51" value="&lt;b style=&quot;font-size:14px&quot;&gt;Trajectory buffer&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;graphs, legal actions, chosen actions,&lt;br&gt;results&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a8a85;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="1405" y="840" width="370" height="80" as="geometry"/></mxCell><mxCell id="system_overview-52" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="system_overview-48" target="system_overview-49"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="system_overview-53" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="system_overview-49" target="system_overview-51"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="system_overview-54" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="system_overview-51" target="system_overview-50"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="system_overview-55" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="system_overview-50" target="system_overview-48"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="system_overview-56" value="network" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="system_overview-24" target="system_overview-49"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="system_overview-57" value="trained agents" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="system_overview-48" target="system_overview-36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="system_overview-58" value="Decks: random legal decks from a randomized synthetic card pool, so the agent learns the card space rather than memorising cards" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="985" y="925" width="790" height="20" as="geometry"/></mxCell><mxCell id="system_overview-59" value="Bootstrapping: start with vanilla units and a rough cost formula. Each round trains the agent on a randomized pool, refits the cost model, then adds the next layer of mechanics: keywords → triggered abilities → actions &amp; items → sites &amp; chants." style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#6b6b66;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="20" y="962" width="1780" height="24" as="geometry"/></mxCell><mxCell id="system_overview-60" value="Card definitions are pure data: the same file tells the engine how to play a card and tells the network what it does, so new cards need no new code and no retraining from scratch." style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#6b6b66;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="20" y="988" width="1780" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="state_graph" id="state_graph"><mxGraphModel grid="1" gridSize="10" page="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="state_graph-1" value="Inside the state graph: one decision point, seen by you" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=20;fontStyle=1;fontColor=#1f1f1e;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1600" height="30" as="geometry"/></mxCell><mxCell id="state_graph-2" value="&lt;b style=&quot;font-size:14px&quot;&gt;Player: you&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;12 VP · energy 5 of 6 ready · hand 4 · deck 38&lt;br&gt;added energy this turn: no&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2a78d6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="330" height="70" as="geometry"/></mxCell><mxCell id="state_graph-3" value="&lt;b style=&quot;font-size:14px&quot;&gt;Global&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;turn 7 · main phase · your turn&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a8a85;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="700" y="60" width="300" height="70" as="geometry"/></mxCell><mxCell id="state_graph-4" value="&lt;b style=&quot;font-size:14px&quot;&gt;Player: opponent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;9 VP · energy 6 · hand 5 · deck 40&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#eb6834;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="1330" y="60" width="330" height="70" as="geometry"/></mxCell><mxCell id="state_graph-5" value="Your hand" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#e6effb;strokeColor=#2a78d6;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontFamily=Helvetica;fontSize=15;fontStyle=1;fontColor=#1f1f1e;" vertex="1" parent="1"><mxGeometry x="20" y="170" width="840" height="420" as="geometry"/></mxCell><mxCell id="state_graph-6" value="&lt;b&gt;Ability subgraphs&lt;/b&gt; (compiled from each card’s DSL tree)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#6b6b66;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="220" y="178" width="600" height="24" as="geometry"/></mxCell><mxCell id="state_graph-7" value="&lt;b style=&quot;font-size:14px&quot;&gt;Unit card&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;cost 4 · power 3&lt;br&gt;health 4 · score 1&lt;br&gt;trait A&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2a78d6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="160" height="76" as="geometry"/></mxCell><mxCell id="state_graph-8" value="&lt;b style=&quot;font-size:14px&quot;&gt;Ability&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;triggered&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#efeafb;strokeColor=#7b5cd6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="230" y="233" width="120" height="70" as="geometry"/></mxCell><mxCell id="state_graph-9" value="&lt;b style=&quot;font-size:14px&quot;&gt;Effect&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;can’t ready&lt;br&gt;until their next turn&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#efeafb;strokeColor=#7b5cd6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="380" y="233" width="170" height="70" as="geometry"/></mxCell><mxCell id="state_graph-10" value="&lt;b style=&quot;font-size:14px&quot;&gt;Selector&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;choose 1&lt;br&gt;chooser: you&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#efeafb;strokeColor=#7b5cd6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="580" y="233" width="120" height="70" as="geometry"/></mxCell><mxCell id="state_graph-11" value="&lt;b style=&quot;font-size:14px&quot;&gt;Filter&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;unit&lt;br&gt;owner: opponent&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#efeafb;strokeColor=#7b5cd6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="720" y="233" width="125" height="70" as="geometry"/></mxCell><mxCell id="state_graph-12" value="&lt;b style=&quot;font-size:14px&quot;&gt;Trigger&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;when played&lt;br&gt;source: this card&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#efeafb;strokeColor=#7b5cd6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="230" y="333" width="120" height="70" as="geometry"/></mxCell><mxCell id="state_graph-13" value="has_ability" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="state_graph-7" target="state_graph-8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="state_graph-14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="state_graph-8" target="state_graph-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="state_graph-15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="state_graph-9" target="state_graph-10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="state_graph-16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="state_graph-10" target="state_graph-11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="state_graph-17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="state_graph-8" target="state_graph-12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="state_graph-18" value="“When you play this unit, choose an opposing unit. It can’t ready at the start of its next turn.”" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="380" y="330" width="460" height="50" as="geometry"/></mxCell><mxCell id="state_graph-19" value="&lt;b style=&quot;font-size:14px&quot;&gt;Action card&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;cost 2&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2a78d6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="160" height="76" as="geometry"/></mxCell><mxCell id="state_graph-20" value="&lt;b style=&quot;font-size:14px&quot;&gt;Ability&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;on resolve&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#efeafb;strokeColor=#7b5cd6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="230" y="443" width="120" height="70" as="geometry"/></mxCell><mxCell id="state_graph-21" value="&lt;b style=&quot;font-size:14px&quot;&gt;Effect&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;remove damage&lt;br&gt;amount: all&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#efeafb;strokeColor=#7b5cd6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="380" y="443" width="170" height="70" as="geometry"/></mxCell><mxCell id="state_graph-22" value="&lt;b style=&quot;font-size:14px&quot;&gt;Selector&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;all matching&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#efeafb;strokeColor=#7b5cd6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="580" y="443" width="120" height="70" as="geometry"/></mxCell><mxCell id="state_graph-23" value="&lt;b style=&quot;font-size:14px&quot;&gt;Filter&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;unit, yours&lt;br&gt;trait A&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#efeafb;strokeColor=#7b5cd6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="720" y="443" width="125" height="70" as="geometry"/></mxCell><mxCell id="state_graph-24" value="has_ability" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeCol