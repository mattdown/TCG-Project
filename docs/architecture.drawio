<mxfile host="drawio"><diagram name="system_overview" id="system_overview"><mxGraphModel grid="1" gridSize="10" page="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="system_overview-1" value="TCG-Project: rules engine, state graph, model, self-play and card generation" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=20;fontStyle=1;fontColor=#1f1f1e;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1200" height="30" as="geometry"/></mxCell><mxCell id="system_overview-2" value="Card definitions (pure data)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#efeafb;strokeColor=#7b5cd6;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontFamily=Helvetica;fontSize=15;fontStyle=1;fontColor=#1f1f1e;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="400" height="540" as="geometry"/></mxCell><mxCell id="system_overview-3" value="&lt;b style=&quot;font-size:14px&quot;&gt;Starter set&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;~30–60 cards written by hand;&lt;br&gt;engine test fixtures and a sanity anchor&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7b5cd6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="360" height="80" as="geometry"/></mxCell><mxCell id="system_overview-4" value="&lt;b style=&quot;font-size:14px&quot;&gt;Typed ability DSL&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;building blocks with types and value ranges;&lt;br&gt;a renderer turns every tree into card text&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7b5cd6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="205" width="360" height="80" as="geometry"/></mxCell><mxCell id="system_overview-5" value="&lt;b style=&quot;font-size:14px&quot;&gt;Card definition (one JSON schema)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;&lt;div style='text-align:left;margin-top:6px'&gt;• &lt;b&gt;Stats&lt;/b&gt; → feature vector: type, aspects,&lt;br&gt;&amp;nbsp;&amp;nbsp;cost, power, health, traits&lt;br&gt;• &lt;b&gt;Keywords&lt;/b&gt; → parameter features: Charge, Elusive,&lt;br&gt;&amp;nbsp;&amp;nbsp;Guard, Duelist +N, Armor +N&lt;br&gt;• &lt;b&gt;Abilities&lt;/b&gt; → DSL trees: trigger · cost · condition&lt;br&gt;&amp;nbsp;&amp;nbsp;· effect · target selector · filter&lt;/div&gt;&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7b5cd6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="360" height="170" as="geometry"/></mxCell><mxCell id="system_overview-6" value="&lt;b style=&quot;font-size:14px&quot;&gt;Generated cards&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;written by part c in the same schema&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7b5cd6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="360" height="80" as="geometry"/></mxCell><mxCell id="system_overview-7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="system_overview-3" target="system_overview-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="system_overview-8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="system_overview-4" target="system_overview-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="system_overview-9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="system_overview-6" target="system_overview-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="system_overview-10" value="Rules engine (Python, symbolic)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#e6effb;strokeColor=#2a78d6;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontFamily=Helvetica;fontSize=15;fontStyle=1;fontColor=#1f1f1e;" vertex="1" parent="1"><mxGeometry x="480" y="60" width="400" height="540" as="geometry"/></mxCell><mxCell id="system_overview-11" value="&lt;b style=&quot;font-size:14px&quot;&gt;Game state&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;zones, heroes’ health, mana crystals, damage,&lt;br&gt;attacked / fresh, active effects with durations&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2a78d6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="500" y="110" width="360" height="80" as="geometry"/></mxCell><mxCell id="system_overview-12" value="&lt;b style=&quot;font-size:14px&quot;&gt;Turn structure&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;+1 mana crystal → refill → draw → main → end;&lt;br&gt;a hero at 0 health loses&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2a78d6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="500" y="205" width="360" height="80" as="geometry"/></mxCell><mxCell id="system_overview-13" value="&lt;b style=&quot;font-size:14px&quot;&gt;DSL interpreter&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;runs the card definitions: triggers, costs,&lt;br&gt;conditions, effects, durations&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2a78d6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="500" y="300" width="360" height="80" as="geometry"/></mxCell><mxCell id="system_overview-14" value="&lt;b style=&quot;font-size:14px&quot;&gt;Legal actions &amp;amp; choices&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;play, attack a unit, attack the hero,&lt;br&gt;Spare Spore, then one decision per target&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2a78d6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="500" y="395" width="360" height="80" as="geometry"/></mxCell><mxCell id="system_overview-15" value="&lt;b style=&quot;font-size:14px&quot;&gt;Environment API&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;reset · legal_actions · step · observe(player)&lt;br&gt;· clone · determinize&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2a78d6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="500" y="490" width="360" height="80" as="geometry"/></mxCell><mxCell id="system_overview-16" value="card defs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;exitX=1;exitY=0.28;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="system_overview-5" target="system_overview-13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="system_overview-17" value="Graph builder (observation → graph)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fdece5;strokeColor=#eb6834;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontFamily=Helvetica;fontSize=15;fontStyle=1;fontColor=#1f1f1e;" vertex="1" parent="1"><mxGeometry x="940" y="60" width="400" height="540" as="geometry"/></mxCell><mxCell id="system_overview-18" value="&lt;b style=&quot;font-size:14px&quot;&gt;Card-instance nodes&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;card embedding + dynamic state: zone, attacked,&lt;br&gt;damage, fresh, hidden, frozen, modifiers&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#eb6834;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="960" y="110" width="360" height="80" as="geometry"/></mxCell><mxCell id="system_overview-19" value="&lt;b style=&quot;font-size:14px&quot;&gt;Ability subgraph nodes&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;ability · trigger · cost · condition · effect&lt;br&gt;· selector · filter, each with parameters&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#eb6834;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="960" y="205" width="360" height="80" as="geometry"/></mxCell><mxCell id="system_overview-20" value="&lt;b style=&quot;font-size:14px&quot;&gt;Player, global &amp;amp; effect nodes&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;hero health, mana, hand/deck size, turn, phase;&lt;br&gt;active effects (e.g. “frozen next turn”)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#eb6834;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="960" y="300" width="360" height="80" as="geometry"/></mxCell><mxCell id="system_overview-21" value="&lt;b style=&quot;font-size:14px&quot;&gt;Edges&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;static: has_ability, ability structure&lt;br&gt;dynamic: in_zone, faces,&lt;br&gt;matches (filter → card), affects (effect → card)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#eb6834;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="960" y="395" width="360" height="80" as="geometry"/></mxCell><mxCell id="system_overview-22" value="&lt;b style=&quot;font-size:14px&quot;&gt;Hidden information&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;one graph per player: opponent’s hand and deck&lt;br&gt;are counts only, no card nodes&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#eb6834;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="960" y="490" width="360" height="80" as="geometry"/></mxCell><mxCell id="system_overview-23" value="observe()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="system_overview-10" target="system_overview-17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="system_overview-24" value="Model (PyTorch Geometric)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#e3f6ef;strokeColor=#1baf7a;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontFamily=Helvetica;fontSize=15;fontStyle=1;fontColor=#1f1f1e;" vertex="1" parent="1"><mxGeometry x="1400" y="60" width="400" height="540" as="geometry"/></mxCell><mxCell id="system_overview-25" value="&lt;b style=&quot;font-size:14px&quot;&gt;Card encoder&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;stats + keywords + ability subgraph&lt;br&gt;→ card embedding, cached per card&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1baf7a;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="1420" y="110" width="360" height="80" as="geometry"/></mxCell><mxCell id="system_overview-26" value="&lt;b style=&quot;font-size:14px&quot;&gt;State encoder&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;heterogeneous GNN (or entity transformer)&lt;br&gt;over the whole state graph&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1baf7a;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="1420" y="205" width="360" height="80" as="geometry"/></mxCell><mxCell id="system_overview-27" value="&lt;b style=&quot;font-size:14px&quot;&gt;Policy head&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;scores each legal action from the embeddings&lt;br&gt;of the nodes it refers to (actor, target)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1baf7a;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="1420" y="300" width="360" height="80" as="geometry"/></mxCell><mxCell id="system_overview-28" value="&lt;b style=&quot;font-size:14px&quot;&gt;Value head&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;win probability; auxiliary: health difference,&lt;br&gt;turns remaining&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1baf7a;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="1420" y="395" width="360" height="80" as="geometry"/></mxCell><mxCell id="system_overview-29" value="&lt;b style=&quot;font-size:14px&quot;&gt;Cost model&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;predicts a card’s fair cost from its embedding;&lt;br&gt;no per-card IDs, so it works on new cards&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1baf7a;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="1420" y="490" width="360" height="80" as="geometry"/></mxCell><mxCell id="system_overview-30" value="graphs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="system_overview-17" target="system_overview-24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="system_overview-31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="system_overview-25" target="system_overview-26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="system_overview-32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="system_overview-26" target="system_overview-27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="system_overview-33" value="c. Card set generation" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#8a8a85;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontFamily=Helvetica;fontSize=15;fontStyle=1;fontColor=#1f1f1e;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="20" y="650" width="880" height="300" as="geometry"/></mxCell><mxCell id="system_overview-34" value="&lt;b style=&quot;font-size:14px&quot;&gt;Accepted set (~3000 cards)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;joins the card pool&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a8a85;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="260" height="80" as="geometry"/></mxCell><mxCell id="system_overview-35" value="&lt;b style=&quot;font-size:14px&quot;&gt;Balance &amp;amp; interest metrics&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;win rate when played, inclusion rate,&lt;br&gt;archetypes, decision entropy, comebacks&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a8a85;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="330" y="700" width="260" height="80" as="geometry"/></mxCell><mxCell id="system_overview-36" value="&lt;b style=&quot;font-size:14px&quot;&gt;Simulated tournaments&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;trained agents + deckbuilder&lt;br&gt;play the candidate set&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a8a85;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="620" y="700" width="260" height="80" as="geometry"/></mxCell><mxCell id="system_overview-37" value="&lt;b style=&quot;font-size:14px&quot;&gt;Effect generator&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;grammar-constrained sampling, or an LLM&lt;br&gt;with grammar-constrained decoding&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a8a85;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="840" width="260" height="80" as="geometry"/></mxCell><mxCell id="system_overview-38" value="&lt;b style=&quot;font-size:14px&quot;&gt;Validity check&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;types and ranges hold; in simulated games&lt;br&gt;it does something and never loops&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a8a85;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="330" y="840" width="260" height="80" as="geometry"/></mxCell><mxCell id="system_overview-39" value="&lt;b style=&quot;font-size:14px&quot;&gt;Auto-costing&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;the cost model sets cost and stats,&lt;br&gt;so the generator never has to&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a8a85;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="620" y="840" width="260" height="80" as="geometry"/></mxCell><mxCell id="system_overview-40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="system_overview-37" target="system_overview-38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="system_overview-41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="system_overview-38" target="system_overview-39"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="system_overview-42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="system_overview-39" target="system_overview-36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="system_overview-43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="system_overview-36" target="system_overview-35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="system_overview-44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="system_overview-35" target="system_overview-34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="system_overview-45" value="revise" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="system_overview-35" target="system_overview-37"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="460" y="810"/><mxPoint x="170" y="810"/></Array></mxGeometry></mxCell><mxCell id="system_overview-46" value="new cards" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="system_overview-34" target="system_overview-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="system_overview-47" value="b. Self-play training" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#8a8a85;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontFamily=Helvetica;fontSize=15;fontStyle=1;fontColor=#1f1f1e;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="960" y="650" width="840" height="300" as="geometry"/></mxCell><mxCell id="system_overview-48" value="&lt;b style=&quot;font-size:14px&quot;&gt;Checkpoints &amp;amp; league&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;past versions as opponents; evaluation&lt;br&gt;against hand-written heuristic agents&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a8a85;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="985" y="700" width="370" height="80" as="geometry"/></mxCell><mxCell id="system_overview-49" value="&lt;b style=&quot;font-size:14px&quot;&gt;Actors&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;many engine instances in parallel,&lt;br&gt;batched GPU inference&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a8a85;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="1405" y="700" width="370" height="80" as="geometry"/></mxCell><mxCell id="system_overview-50" value="&lt;b style=&quot;font-size:14px&quot;&gt;Learner&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;PPO with action masking first;&lt;br&gt;AlphaZero-style determinized search later&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a8a85;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="985" y="840" width="370" height="80" as="geometry"/></mxCell><mxCell id="system_overview-51" value="&lt;b style=&quot;font-size:14px&quot;&gt;Trajectory buffer&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;graphs, legal actions, chosen actions,&lt;br&gt;results&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a8a85;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="1405" y="840" width="370" height="80" as="geometry"/></mxCell><mxCell id="system_overview-52" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="system_overview-48" target="system_overview-49"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="system_overview-53" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="system_overview-49" target="system_overview-51"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="system_overview-54" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="system_overview-51" target="system_overview-50"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="system_overview-55" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="system_overview-50" target="system_overview-48"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="system_overview-56" value="network" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="system_overview-24" target="system_overview-49"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="system_overview-57" value="trained agents" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="system_overview-48" target="system_overview-36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="system_overview-58" value="Decks: random legal decks from a randomized synthetic card pool, so the agent learns the card space rather than memorising cards" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="985" y="925" width="790" height="20" as="geometry"/></mxCell><mxCell id="system_overview-59" value="Bootstrapping: start with vanilla units and a rough cost formula. Each round trains the agent on a randomized pool, refits the cost model, then adds the next layer of mechanics: keywords → triggered abilities → actions &amp; items → a mechanic of our own." style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#6b6b66;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="20" y="962" width="1780" height="24" as="geometry"/></mxCell><mxCell id="system_overview-60" value="Card definitions are pure data: the same file tells the engine how to play a card and tells the network what it does, so new cards need no new code and no retraining from scratch." style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#6b6b66;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="20" y="988" width="1780" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="state_graph" id="state_graph"><mxGraphModel grid="1" gridSize="10" page="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="state_graph-1" value="Inside the state graph: a decision in the middle of resolving an ability" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=20;fontStyle=1;fontColor=#1f1f1e;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1600" height="30" as="geometry"/></mxCell><mxCell id="state_graph-2" value="&lt;b style=&quot;font-size:14px&quot;&gt;Player: you&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;health 24 · mana 1 of 6 · hand 4 · deck 18&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2a78d6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="330" height="70" as="geometry"/></mxCell><mxCell id="state_graph-3" value="&lt;b style=&quot;font-size:14px&quot;&gt;Global&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;turn 7 · main phase · your turn&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a8a85;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="700" y="60" width="300" height="70" as="geometry"/></mxCell><mxCell id="state_graph-4" value="&lt;b style=&quot;font-size:14px&quot;&gt;Player: opponent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;health 19 · mana 6 · hand 5 · deck 20&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#eb6834;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="1330" y="60" width="330" height="70" as="geometry"/></mxCell><mxCell id="state_graph-5" value="Decision graph of unit D's ability (resolving now)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#efeafb;strokeColor=#7b5cd6;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontFamily=Helvetica;fontSize=15;fontStyle=1;fontColor=#1f1f1e;" vertex="1" parent="1"><mxGeometry x="20" y="160" width="1000" height="300" as="geometry"/></mxCell><mxCell id="state_graph-6" value="“When you play this unit, choose an enemy unit and deal 2 damage to it. If it’s defeated, draw a card.”" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="470" y="164" width="540" height="40" as="geometry"/></mxCell><mxCell id="state_graph-7" value="&lt;b style=&quot;font-size:14px&quot;&gt;Entry&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;when played&lt;br&gt;source: unit D&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#efeafb;strokeColor=#7b5cd6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="250" width="170" height="70" as="geometry"/></mxCell><mxCell id="state_graph-8" value="&lt;b style=&quot;font-size:14px&quot;&gt;Choose&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;1 enemy unit&lt;br&gt;chooser: you · as “it”&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#efeafb;strokeColor=#7b5cd6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;strokeColor=#d6455d;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="270" y="250" width="170" height="70" as="geometry"/></mxCell><mxCell id="state_graph-9" value="&lt;b style=&quot;font-size:14px&quot;&gt;Effect&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;deal 2 damage&lt;br&gt;→ it&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#efeafb;strokeColor=#7b5cd6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="480" y="250" width="150" height="70" as="geometry"/></mxCell><mxCell id="state_graph-10" value="&lt;b style=&quot;font-size:14px&quot;&gt;If&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;it was defeated&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#efeafb;strokeColor=#7b5cd6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="670" y="250" width="140" height="70" as="geometry"/></mxCell><mxCell id="state_graph-11" value="&lt;b style=&quot;font-size:14px&quot;&gt;Effect&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;draw 1&lt;br&gt;→ you&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#efeafb;strokeColor=#7b5cd6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="850" y="250" width="150" height="70" as="geometry"/></mxCell><mxCell id="state_graph-12" value="&lt;b style=&quot;font-size:14px&quot;&gt;End&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#efeafb;strokeColor=#7b5cd6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="670" y="370" width="140" height="50" as="geometry"/></mxCell><mxCell id="state_graph-13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="state_graph-7" target="state_graph-8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="state_graph-14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="state_graph-8" target="state_graph-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="state_graph-15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="state_graph-9" target="state_graph-10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="state_graph-16" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="state_graph-10" target="state_graph-11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="state_graph-17" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="state_graph-10" target="state_graph-12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="state_graph-18" value="uses “it”" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7b5cd6;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;dashPattern=2 3;" edge="1" parent="1" source="state_graph-8" target="state_graph-9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="355" y="218"/><mxPoint x="555" y="218"/></Array></mxGeometry></mxCell><mxCell id="state_graph-19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7b5cd6;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;dashPattern=2 3;" edge="1" parent="1" source="state_graph-8" target="state_graph-10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="355" y="218"/><mxPoint x="740" y="218"/></Array></mxGeometry></mxCell><mxCell id="state_graph-20" value="&lt;b style=&quot;font-size:14px&quot;&gt;Current decision: the Choose node&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;&lt;div style='text-align:left;margin-top:6px'&gt;• The engine is part-way through unit D’s ability. Its state is plain data:&lt;br&gt;&amp;nbsp;&amp;nbsp;(unit D, ability 1, current node = Choose, chosen so far = none)&lt;br&gt;• Legal options: one per card the Choose node &lt;b&gt;matches&lt;/b&gt;, here unit X and unit Y&lt;br&gt;• Each option is scored from&lt;br&gt;&amp;nbsp;&amp;nbsp;[action type: choose | actor: unit D | target: X or Y | &lt;b&gt;context: the Choose node&lt;/b&gt; | global]&lt;br&gt;• Once chosen, a &lt;b&gt;bound_to&lt;/b&gt; edge links the Choose node to that unit, and the engine&lt;br&gt;&amp;nbsp;&amp;nbsp;carries on through Effect and If without pausing (they need no decision)&lt;/div&gt;&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fbe8eb;strokeColor=#d6455d;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=left;verticalAlign=top;arcSize=3;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1060" y="160" width="620" height="300" as="geometry"/></mxCell><mxCell id="state_graph-21" value="Your hand" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#e6effb;strokeColor=#2a78d6;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontFamily=Helvetica;fontSize=15;fontStyle=1;fontColor=#1f1f1e;" vertex="1" parent="1"><mxGeometry x="20" y="500" width="1000" height="190" as="geometry"/></mxCell><mxCell id="state_graph-22" value="&lt;b style=&quot;font-size:14px&quot;&gt;Action card&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;cost 2&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2a78d6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="300" y="560" width="160" height="70" as="geometry"/></mxCell><mxCell id="state_graph-23" value="&lt;b style=&quot;font-size:14px&quot;&gt;Entry&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;on resolve&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#efeafb;strokeColor=#7b5cd6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="500" y="560" width="130" height="70" as="geometry"/></mxCell><mxCell id="state_graph-24" value="&lt;b style=&quot;font-size:14px&quot;&gt;Effect&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;remove all damage&lt;br&gt;→ all(unit · yours · trait A)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#efeafb;strokeColor=#7b5cd6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="670" y="560" width="330" height="70" as="geometry"/></mxCell><mxCell id="state_graph-25" value="has_ability" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="state_graph-22" target="state_graph-23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="state_graph-26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="state_graph-23" target="state_graph-24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="state_graph-27" value="“Remove all damage from your trait A units.”" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="300" y="640" width="380" height="36" as="geometry"/></mxCell><mxCell id="state_graph-28" value="&lt;b style=&quot;font-size:14px&quot;&gt;Opponent’s hand and deck: hidden&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;no card nodes, only the counts on the opponent’s player node&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#8a8a85;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1060" y="500" width="620" height="60" as="geometry"/></mxCell><mxCell id="state_graph-29" value="&lt;b style=&quot;font-size:14px&quot;&gt;Active effect&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;freeze · Unit Y can’t attack on&lt;br&gt;its next turn · source: C&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fbe8eb;strokeColor=#d6455d;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="1300" y="590" width="260" height="70" as="geometry"/></mxCell><mxCell id="state_graph-30" value="Your play area" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#e6effb;strokeColor=#2a78d6;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontFamily=Helvetica;fontSize=15;fontStyle=1;fontColor=#1f1f1e;" vertex="1" parent="1"><mxGeometry x="20" y="730" width="1000" height="180" as="geometry"/></mxCell><mxCell id="state_graph-31" value="&lt;b style=&quot;font-size:14px&quot;&gt;Unit D&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;trait B · fresh (just played)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2a78d6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="790" width="210" height="80" as="geometry"/></mxCell><mxCell id="state_graph-32" value="&lt;b style=&quot;font-size:14px&quot;&gt;Unit A&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;trait A · can attack&lt;br&gt;damage 2 of 4&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2a78d6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="280" y="790" width="210" height="80" as="geometry"/></mxCell><mxCell id="state_graph-33" value="&lt;b style=&quot;font-size:14px&quot;&gt;Unit B&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;trait A · has attacked&lt;br&gt;damage 1 of 3&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2a78d6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="520" y="790" width="210" height="80" as="geometry"/></mxCell><mxCell id="state_graph-34" value="&lt;b style=&quot;font-size:14px&quot;&gt;Unit C&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;trait B · can attack&lt;br&gt;(not matched: not trait A)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2a78d6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="760" y="790" width="210" height="80" as="geometry"/></mxCell><mxCell id="state_graph-35" value="Opponent’s play area" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fdece5;strokeColor=#eb6834;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontFamily=Helvetica;fontSize=15;fontStyle=1;fontColor=#1f1f1e;" vertex="1" parent="1"><mxGeometry x="1060" y="730" width="620" height="180" as="geometry"/></mxCell><mxCell id="state_graph-36" value="&lt;b style=&quot;font-size:14px&quot;&gt;Unit X&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;Guard&lt;br&gt;damage 0 of 5&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#eb6834;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="1080" y="790" width="180" height="80" as="geometry"/></mxCell><mxCell id="state_graph-37" value="&lt;b style=&quot;font-size:14px&quot;&gt;Unit Y&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;frozen&lt;br&gt;damage 3 of 4&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#eb6834;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="1280" y="790" width="180" height="80" as="geometry"/></mxCell><mxCell id="state_graph-38" value="&lt;b style=&quot;font-size:14px&quot;&gt;Unit Z&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;Elusive · hidden&lt;br&gt;(enemies can’t choose it)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#eb6834;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="1480" y="790" width="180" height="80" as="geometry"/></mxCell><mxCell id="state_graph-39" value="has_ability" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="state_graph-31" target="state_graph-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="state_graph-40" value="matches" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d6455d;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="state_graph-8" target="state_graph-36"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="355" y="480"/><mxPoint x="1040" y="480"/><mxPoint x="1040" y="765"/><mxPoint x="1170" y="765"/></Array></mxGeometry></mxCell><mxCell id="state_graph-41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d6455d;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.4;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="state_graph-8" target="state_graph-37"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="355" y="480"/><mxPoint x="1040" y="480"/><mxPoint x="1040" y="765"/><mxPoint x="1352" y="765"/></Array></mxGeometry></mxCell><mxCell id="state_graph-42" value="matches" style="html=1;strokeColor=#d6455d;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="state_graph-24" target="state_graph-32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="state_graph-43" value="matches" style="html=1;strokeColor=#d6455d;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="state_graph-24" target="state_graph-33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="state_graph-44" value="affects" style="html=1;strokeColor=#d6455d;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="state_graph-29" target="state_graph-37"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="state_graph-45" value="&lt;b style=&quot;font-size:14px&quot;&gt;Node features&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;&lt;div style='text-align:left'&gt;• &lt;b&gt;Card instance&lt;/b&gt;: card embedding (from the card encoder) + zone, attacked, damage, fresh, hidden, frozen&lt;br&gt;• &lt;b&gt;Decision-graph nodes&lt;/b&gt; (entry, choose, may, choose one, if, for each, effect, end): node type +&lt;br&gt;&amp;nbsp;&amp;nbsp;parameters (op, amount, count, duration, chooser) + the node’s Filter fields + “being resolved” flag&lt;br&gt;• &lt;b&gt;Player / global&lt;/b&gt;: hero health, mana and crystals, hand and deck size, Spare Spore, turn, phase&lt;br&gt;• &lt;b&gt;Active effect&lt;/b&gt;: effect type + parameters + turns until it expires&lt;/div&gt;&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a8a85;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="950" width="1000" height="140" as="geometry"/></mxCell><mxCell id="state_graph-46" value="&lt;b style=&quot;font-size:14px&quot;&gt;Edges&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;&lt;div style='text-align:left'&gt;• &lt;b&gt;Grey, solid&lt;/b&gt;: control flow (what happens next) and has_ability; fixed per card&lt;br&gt;• &lt;b style='color:#7b5cd6'&gt;Purple, dotted&lt;/b&gt;: data flow (uses): a choice → every step that refers to it&lt;br&gt;• &lt;b style='color:#d6455d'&gt;Red, dashed&lt;/b&gt;: computed by the engine at every decision: matches, affects, bound_to&lt;br&gt;• &lt;b style='color:#d6455d'&gt;Red outline&lt;/b&gt;: the decision node being resolved, the policy’s context&lt;br&gt;• Zone, owner and player-to-card edges are left out of this picture for clarity&lt;/div&gt;&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a8a85;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=left;" vertex="1" parent="1"><mxGeometry x="1060" y="950" width="620" height="140" as="geometry"/></mxCell><mxCell id="state_graph-47" value="All game terms are placeholders until the game has a name and theme." style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#6b6b66;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="20" y="1100" width="1660" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="ability_grammar" id="ability_grammar"><mxGraphModel grid="1" gridSize="10" page="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ability_grammar-1" value="Ability grammar: every ability the generator can produce" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=20;fontStyle=1;fontColor=#1f1f1e;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1600" height="30" as="geometry"/></mxCell><mxCell id="ability_grammar-2" value="&lt;b style=&quot;font-size:14px&quot;&gt;Card&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;&lt;div style='text-align:left;margin-top:4px'&gt;type · aspects&lt;br&gt;cost · power · health&lt;br&gt;traits&lt;br&gt;keywords (0–2)&lt;br&gt;abilities (1 for now)&lt;/div&gt;&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2a78d6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=left;verticalAlign=top;arcSize=3;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="240" height="125" as="geometry"/></mxCell><mxCell id="ability_grammar-3" value="&lt;b style=&quot;font-size:14px&quot;&gt;Keyword&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;&lt;div style='text-align:left;margin-top:4px'&gt;Guard · Elusive · Charge&lt;br&gt;Duelist +[1–3] · Armor +[1–2]&lt;br&gt;&lt;i&gt;declarative: the rules check them,&lt;br&gt;no flow&lt;/i&gt;&lt;/div&gt;&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2a78d6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=left;verticalAlign=top;arcSize=3;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="20" y="250" width="240" height="170" as="geometry"/></mxCell><mxCell id="ability_grammar-4" value="keywords" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ability_grammar-2" target="ability_grammar-3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ability_grammar-5" value="Ability (1 per card for now)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#efeafb;strokeColor=#7b5cd6;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontFamily=Helvetica;fontSize=15;fontStyle=1;fontColor=#1f1f1e;" vertex="1" parent="1"><mxGeometry x="290" y="70" width="300" height="340" as="geometry"/></mxCell><mxCell id="ability_grammar-6" value="&lt;b style=&quot;font-size:14px&quot;&gt;Triggered&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;&lt;div style='text-align:left;margin-top:4px'&gt;Trigger → [Condition] → Steps&lt;br&gt;&lt;i&gt;units&lt;/i&gt;&lt;/div&gt;&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7b5cd6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=left;verticalAlign=top;arcSize=3;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="310" y="115" width="260" height="75" as="geometry"/></mxCell><mxCell id="ability_grammar-8" value="&lt;b style=&quot;font-size:14px&quot;&gt;On resolve&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;&lt;div style='text-align:left;margin-top:4px'&gt;Steps&lt;br&gt;&lt;i&gt;action cards&lt;/i&gt;&lt;/div&gt;&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7b5cd6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=left;verticalAlign=top;arcSize=3;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="310" y="205" width="260" height="75" as="geometry"/></mxCell><mxCell id="ability_grammar-9" value="&lt;b style=&quot;font-size:14px&quot;&gt;Static&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;&lt;div style='text-align:left;margin-top:4px'&gt;[Condition] → Modifier+&lt;br&gt;&lt;i&gt;declarative: applied whenever&lt;br&gt;stats are calculated&lt;/i&gt;&lt;/div&gt;&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7b5cd6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=left;verticalAlign=top;arcSize=3;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="310" y="295" width="260" height="100" as="geometry"/></mxCell><mxCell id="ability_grammar-10" value="abilities" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.15;entryDx=0;entryDy=0;" edge="1" parent="1" source="ability_grammar-2" target="ability_grammar-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ability_grammar-11" value="&lt;b style=&quot;font-size:14px&quot;&gt;Trigger&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;&lt;div style='text-align:left;margin-top:4px'&gt;when played · when this attacks the hero&lt;br&gt;when this attacks&lt;br&gt;when this is defeated&lt;br&gt;start of your turn · end of your turn&lt;br&gt;when you play another [Filter]&lt;br&gt;when an enemy [Filter] is defeated&lt;/div&gt;&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7b5cd6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=left;verticalAlign=top;arcSize=3;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="630" y="70" width="300" height="150" as="geometry"/></mxCell><mxCell id="ability_grammar-13" value="&lt;b style=&quot;font-size:14px&quot;&gt;Condition&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;&lt;div style='text-align:left;margin-top:4px'&gt;it was defeated · it is still in play&lt;br&gt;count([Filter]) ≥ [2–3]&lt;br&gt;your hero has less health than theirs&lt;br&gt;it is your turn | their turn&lt;br&gt;this is attacking | defending&lt;br&gt;this is damaged&lt;/div&gt;&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7b5cd6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=left;verticalAlign=top;arcSize=3;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="630" y="355" width="300" height="165" as="geometry"/></mxCell><mxCell id="ability_grammar-14" value="&lt;b style=&quot;font-size:14px&quot;&gt;Modifier&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;&lt;div style='text-align:left;margin-top:4px'&gt;this card | all([Filter]) get&lt;br&gt;&amp;nbsp;&amp;nbsp;power | health ±Amount&lt;br&gt;this card | all([Filter]) gain a Keyword&lt;br&gt;cards matching [Filter] cost 1 less&lt;br&gt;[while Condition]&lt;/div&gt;&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7b5cd6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=left;verticalAlign=top;arcSize=3;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="630" y="535" width="300" height="135" as="geometry"/></mxCell><mxCell id="ability_grammar-15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ability_grammar-6" target="ability_grammar-11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ability_grammar-17" value="condition" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;exitX=1;exitY=0.83;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ability_grammar-5" target="ability_grammar-13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ability_grammar-18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ability_grammar-9" target="ability_grammar-14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ability_grammar-19" value="&lt;b style=&quot;font-size:14px&quot;&gt;Steps&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;&lt;div style='text-align:left;margin-top:4px'&gt;1–4 steps, run in order&lt;/div&gt;&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7b5cd6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=left;verticalAlign=top;arcSize=3;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="970" y="70" width="360" height="60" as="geometry"/></mxCell><mxCell id="ability_grammar-20" value="&lt;b style=&quot;font-size:14px&quot;&gt;Step (one of)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;&lt;div style='text-align:left;margin-top:4px'&gt;&lt;b&gt;choose&lt;/b&gt; [1–2] [Filter] · chooser you | them&lt;br&gt;&amp;nbsp;&amp;nbsp;· optional? · &lt;b&gt;as&lt;/b&gt; a name &amp;nbsp;&lt;i&gt;(decision)&lt;/i&gt;&lt;br&gt;&lt;b&gt;Effect&lt;/b&gt;&lt;br&gt;&lt;b&gt;if&lt;/b&gt; Condition &lt;b&gt;then&lt;/b&gt; Steps [&lt;b&gt;else&lt;/b&gt; Steps]&lt;br&gt;&lt;b&gt;may&lt;/b&gt; Steps [&lt;b&gt;if you do&lt;/b&gt; Steps] &amp;nbsp;&lt;i&gt;(decision)&lt;/i&gt;&lt;br&gt;&lt;b&gt;choose one&lt;/b&gt;: Steps | Steps &amp;nbsp;&lt;i&gt;(decision)&lt;/i&gt;&lt;br&gt;&lt;b&gt;for each&lt;/b&gt; Target: Steps&lt;br&gt;&lt;br&gt;&lt;i&gt;↻ nested Steps go at most 2 levels deep&lt;/i&gt;&lt;/div&gt;&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7b5cd6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=left;verticalAlign=top;arcSize=3;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="970" y="160" width="360" height="255" as="geometry"/></mxCell><mxCell id="ability_grammar-21" value="&lt;b style=&quot;font-size:14px&quot;&gt;Target&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;&lt;div style='text-align:left;margin-top:4px'&gt;an earlier choice, by name · this card&lt;br&gt;all([Filter])&lt;br&gt;you · the opponent · that card’s owner&lt;/div&gt;&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7b5cd6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=left;verticalAlign=top;arcSize=3;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="970" y="440" width="360" height="95" as="geometry"/></mxCell><mxCell id="ability_grammar-22" value="&lt;b style=&quot;font-size:14px&quot;&gt;Filter (all fields optional)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;&lt;div style='text-align:left;margin-top:4px'&gt;type: unit · owner: you | them | any&lt;br&gt;zone: play | hand | discard · trait&lt;br&gt;cost ≤ [2–4] · damaged&lt;br&gt;has a Keyword · not this card&lt;br&gt;&lt;i&gt;used by choose, all(…), count(…), triggers, modifiers&lt;/i&gt;&lt;/div&gt;&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7b5cd6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=left;verticalAlign=top;arcSize=3;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="970" y="555" width="360" height="125" as="geometry"/></mxCell><mxCell id="ability_grammar-23" value="Steps" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ability_grammar-5" target="ability_grammar-19"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="440" y="52"/><mxPoint x="1150" y="52"/></Array></mxGeometry></mxCell><mxCell id="ability_grammar-24" value="each step" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ability_grammar-19" target="ability_grammar-20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ability_grammar-25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;exitX=0;exitY=0.15;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ability_grammar-20" target="ability_grammar-19"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="950" y="198"/><mxPoint x="950" y="100"/></Array></mxGeometry></mxCell><mxCell id="ability_grammar-26" value="if" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ability_grammar-20" target="ability_grammar-13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ability_grammar-27" value="all(…)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ability_grammar-21" target="ability_grammar-22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ability_grammar-28" value="&lt;b style=&quot;font-size:14px&quot;&gt;Effect: op → Target&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;&lt;table style='border-collapse:collapse;font-size:11px;margin-top:4px'&gt;&lt;tr&gt;&lt;td style='padding:1px 6px;border-bottom:1px solid #e4e4e0'&gt;&lt;b&gt;op&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 6px;border-bottom:1px solid #e4e4e0'&gt;&lt;b&gt;target&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 6px;border-bottom:1px solid #e4e4e0'&gt;&lt;b&gt;parameters&lt;/b&gt; (any number can be an Amount)&lt;/td&gt;&lt;td style='padding:1px 6px;border-bottom:1px solid #e4e4e0'&gt;&lt;b&gt;polarity&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px;border-bottom:1px solid #e4e4e0'&gt;deal damage&lt;/td&gt;&lt;td style='padding:1px 6px;border-bottom:1px solid #e4e4e0'&gt;unit&lt;/td&gt;&lt;td style='padding:1px 6px;border-bottom:1px solid #e4e4e0'&gt;[1–5]&lt;/td&gt;&lt;td style='padding:1px 6px;border-bottom:1px solid #e4e4e0'&gt;hurts&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px;border-bottom:1px solid #e4e4e0'&gt;remove damage&lt;/td&gt;&lt;td style='padding:1px 6px;border-bottom:1px solid #e4e4e0'&gt;unit&lt;/td&gt;&lt;td style='padding:1px 6px;border-bottom:1px solid #e4e4e0'&gt;[1–5] | all&lt;/td&gt;&lt;td style='padding:1px 6px;border-bottom:1px solid #e4e4e0'&gt;helps&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px;border-bottom:1px solid #e4e4e0'&gt;defeat&lt;/td&gt;&lt;td style='padding:1px 6px;border-bottom:1px solid #e4e4e0'&gt;unit&lt;/td&gt;&lt;td style='padding:1px 6px;border-bottom:1px solid #e4e4e0'&gt;&lt;/td&gt;&lt;td style='padding:1px 6px;border-bottom:1px solid #e4e4e0'&gt;hurts&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px;border-bottom:1px solid #e4e4e0'&gt;return to hand&lt;/td&gt;&lt;td style='padding:1px 6px;border-bottom:1px solid #e4e4e0'&gt;unit&lt;/td&gt;&lt;td style='padding:1px 6px;border-bottom:1px solid #e4e4e0'&gt;&lt;/td&gt;&lt;td style='padding:1px 6px;border-bottom:1px solid #e4e4e0'&gt;hurts&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px;border-bottom:1px solid #e4e4e0'&gt;freeze&lt;/td&gt;&lt;td style='padding:1px 6px;border-bottom:1px solid #e4e4e0'&gt;unit&lt;/td&gt;&lt;td style='padding:1px 6px;border-bottom:1px solid #e4e4e0'&gt;can’t attack next turn&lt;/td&gt;&lt;td style='padding:1px 6px;border-bottom:1px solid #e4e4e0'&gt;hurts&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px;border-bottom:1px solid #e4e4e0'&gt;power | health&lt;/td&gt;&lt;td style='padding:1px 6px;border-bottom:1px solid #e4e4e0'&gt;unit&lt;/td&gt;&lt;td style='padding:1px 6px;border-bottom:1px solid #e4e4e0'&gt;±[1–3], Duration&lt;/td&gt;&lt;td style='padding:1px 6px;border-bottom:1px solid #e4e4e0'&gt;sign&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px;border-bottom:1px solid #e4e4e0'&gt;gain a Keyword&lt;/td&gt;&lt;td style='padding:1px 6px;border-bottom:1px solid #e4e4e0'&gt;unit&lt;/td&gt;&lt;td style='padding:1px 6px;border-bottom:1px solid #e4e4e0'&gt;Duration&lt;/td&gt;&lt;td style='padding:1px 6px;border-bottom:1px solid #e4e4e0'&gt;helps&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px;border-bottom:1px solid #e4e4e0'&gt;draw&lt;/td&gt;&lt;td style='padding:1px 6px;border-bottom:1px solid #e4e4e0'&gt;player&lt;/td&gt;&lt;td style='padding:1px 6px;border-bottom:1px solid #e4e4e0'&gt;[1–3]&lt;/td&gt;&lt;td style='padding:1px 6px;border-bottom:1px solid #e4e4e0'&gt;helps&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px;border-bottom:1px solid #e4e4e0'&gt;discard&lt;/td&gt;&lt;td style='padding:1px 6px;border-bottom:1px solid #e4e4e0'&gt;player&lt;/td&gt;&lt;td style='padding:1px 6px;border-bottom:1px solid #e4e4e0'&gt;[1–2], random | chosen&lt;/td&gt;&lt;td style='padding:1px 6px;border-bottom:1px solid #e4e4e0'&gt;hurts&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px;border-bottom:1px solid #e4e4e0'&gt;heal your hero&lt;/td&gt;&lt;td style='padding:1px 6px;border-bottom:1px solid #e4e4e0'&gt;player&lt;/td&gt;&lt;td style='padding:1px 6px;border-bottom:1px solid #e4e4e0'&gt;[2–5]&lt;/td&gt;&lt;td style='padding:1px 6px;border-bottom:1px solid #e4e4e0'&gt;helps&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px;border-bottom:1px solid #e4e4e0'&gt;damage a hero&lt;/td&gt;&lt;td style='padding:1px 6px;border-bottom:1px solid #e4e4e0'&gt;player&lt;/td&gt;&lt;td style='padding:1px 6px;border-bottom:1px solid #e4e4e0'&gt;[1–3]&lt;/td&gt;&lt;td style='padding:1px 6px;border-bottom:1px solid #e4e4e0'&gt;hurts&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px;border-bottom:1px solid #e4e4e0'&gt;gain a mana crystal&lt;/td&gt;&lt;td style='padding:1px 6px;border-bottom:1px solid #e4e4e0'&gt;player&lt;/td&gt;&lt;td style='padding:1px 6px;border-bottom:1px solid #e4e4e0'&gt;empty until next turn&lt;/td&gt;&lt;td style='padding:1px 6px;border-bottom:1px solid #e4e4e0'&gt;helps&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7b5cd6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=left;verticalAlign=top;arcSize=3;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1370" y="70" width="420" height="345" as="geometry"/></mxCell><mxCell id="ability_grammar-29" value="&lt;b style=&quot;font-size:14px&quot;&gt;Duration&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;&lt;div style='text-align:left;margin-top:4px'&gt;this turn · until the start of your next turn&lt;br&gt;until the end of their next turn&lt;br&gt;while this card is in play · permanent&lt;/div&gt;&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7b5cd6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=left;verticalAlign=top;arcSize=3;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1370" y="440" width="420" height="90" as="geometry"/></mxCell><mxCell id="ability_grammar-30" value="Effect" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.33;entryDx=0;entryDy=0;" edge="1" parent="1" source="ability_grammar-20" target="ability_grammar-28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ability_grammar-31" value="target" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;exitX=0;exitY=0.93;exitDx=0;exitDy=0;entryX=1;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="ability_grammar-28" target="ability_grammar-21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ability_grammar-32" value="duration" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ability_grammar-28" target="ability_grammar-29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ability_grammar-33" value="&lt;b style=&quot;font-size:14px&quot;&gt;Amount&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;&lt;div style='text-align:left;margin-top:4px'&gt;a number from the op’s [range]&lt;br&gt;[1–2] per count([Filter]), up to [3–5]&lt;br&gt;the power | health of an earlier choice&lt;br&gt;&lt;i&gt;used by effects and modifiers&lt;/i&gt;&lt;/div&gt;&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7b5cd6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=left;verticalAlign=top;arcSize=3;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1370" y="535" width="420" height="105" as="geometry"/></mxCell><mxCell id="ability_grammar-34" value="amounts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;exitX=1;exitY=0.9;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ability_grammar-28" target="ability_grammar-33"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1810" y="380"/><mxPoint x="1810" y="587"/></Array></mxGeometry></mxCell><mxCell id="ability_grammar-35" value="&lt;b style=&quot;font-size:14px&quot;&gt;Constraints, applied while sampling and checked before a card is accepted&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;&lt;div style='text-align:left;margin-top:6px'&gt;• &lt;b&gt;Scope&lt;/b&gt;: a name only refers to a choice made earlier in the same ability&lt;br&gt;• &lt;b&gt;Types&lt;/b&gt;: an effect’s target has the right type (unit effects → units, player effects → players)&lt;br&gt;• &lt;b&gt;Polarity&lt;/b&gt;: “helps” targets your side, “hurts” the opponent’s; the reverse only inside &lt;b&gt;may … if you do&lt;/b&gt;, as a cost&lt;br&gt;• &lt;b&gt;No runaways&lt;/b&gt;: units only attack, once a turn; no ready effects&lt;br&gt;• &lt;b&gt;Must matter&lt;/b&gt;: “while damaged” needs ≥ 2 health; granted Guard / Armor&lt;br&gt;&amp;nbsp;&amp;nbsp;last until your next turn; Charge and Elusive are never granted; no +power this turn on a fresh unit&lt;br&gt;• &lt;b&gt;Size&lt;/b&gt;: 1 ability per card (generator), ≤ 4 steps per sequence, nesting ≤ 2 levels, ≤ 2 choices per ability&lt;br&gt;• &lt;b&gt;Ranges&lt;/b&gt;: every number comes from its [range]; a scaling Amount must have a cap; ranges are starting values&lt;/div&gt;&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a8a85;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=left;verticalAlign=top;arcSize=3;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="20" y="710" width="910" height="200" as="geometry"/></mxCell><mxCell id="ability_grammar-36" value="Pipeline for each generated card (generate.py)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#8a8a85;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontFamily=Helvetica;fontSize=15;fontStyle=1;fontColor=#1f1f1e;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="970" y="710" width="820" height="200" as="geometry"/></mxCell><mxCell id="ability_grammar-37" value="&lt;b style=&quot;font-size:13px&quot;&gt;1. Sample&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#6b6b66&quot;&gt;a tree, weighted,&lt;br&gt;within the grammar&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a8a85;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="985" y="760" width="122" height="95" as="geometry"/></mxCell><mxCell id="ability_grammar-38" value="&lt;b style=&quot;font-size:13px&quot;&gt;2. Check&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#6b6b66&quot;&gt;scope · types&lt;br&gt;polarity · must matter&lt;br&gt;complexity · narrowing&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a8a85;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="1119" y="760" width="122" height="95" as="geometry"/></mxCell><mxCell id="ability_grammar-39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ability_grammar-37" target="ability_grammar-38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ability_grammar-40" value="&lt;b style=&quot;font-size:13px&quot;&gt;3. Render&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#6b6b66&quot;&gt;the card text&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a8a85;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="1253" y="760" width="122" height="95" as="geometry"/></mxCell><mxCell id="ability_grammar-41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ability_grammar-38" target="ability_grammar-40"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ability_grammar-42" value="&lt;b style=&quot;font-size:13px&quot;&gt;4. Price&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#6b6b66&quot;&gt;from the price table:&lt;br&gt;set by hand or&lt;br&gt;measured in self-play&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a8a85;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="1387" y="760" width="122" height="95" as="geometry"/></mxCell><mxCell id="ability_grammar-43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ability_grammar-40" target="ability_grammar-42"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ability_grammar-44" value="&lt;b style=&quot;font-size:13px&quot;&gt;5. Build&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#6b6b66&quot;&gt;cost and stats that&lt;br&gt;the price leaves room&lt;br&gt;for; maybe a keyword&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a8a85;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="1521" y="760" width="122" height="95" as="geometry"/></mxCell><mxCell id="ability_grammar-45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ability_grammar-42" target="ability_grammar-44"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ability_grammar-46" value="&lt;b style=&quot;font-size:13px&quot;&gt;6. Keep&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#6b6b66&quot;&gt;no duplicates; of a few&lt;br&gt;draws, the shape used&lt;br&gt;least (variety)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a8a85;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="1655" y="760" width="122" height="95" as="geometry"/></mxCell><mxCell id="ability_grammar-47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ability_grammar-44" target="ability_grammar-46"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ability_grammar-49" value="Not per card: the engine compiles an ability to a decision graph when a game uses it (page 2). Self-play checks the engine never crashes or gets stuck (the fuzz test) and measures the prices in the table (experiments.py)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="985" y="862" width="792" height="40" as="geometry"/></mxCell><mxCell id="ability_grammar-48" value="Choices (choose, may, choose one) become decision points when the tree is compiled to a decision graph: see page 2. All names and keywords are placeholders." style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#6b6b66;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="20" y="925" width="1770" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>