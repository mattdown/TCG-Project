pace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#8a8a85;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="900" y="170" width="780" height="70" as="geometry"/></mxCell><mxCell id="state_graph-30" value="&lt;b style=&quot;font-size:14px&quot;&gt;Active effect&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;can’t ready · expires at end of&lt;br&gt;opponent’s next turn · source: C&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fbe8eb;strokeColor=#d6455d;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="1250" y="420" width="240" height="70" as="geometry"/></mxCell><mxCell id="state_graph-31" value="Your play area" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#e6effb;strokeColor=#2a78d6;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontFamily=Helvetica;fontSize=15;fontStyle=1;fontColor=#1f1f1e;" vertex="1" parent="1"><mxGeometry x="20" y="640" width="840" height="190" as="geometry"/></mxCell><mxCell id="state_graph-32" value="&lt;b style=&quot;font-size:14px&quot;&gt;Unit A&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;trait A · ready&lt;br&gt;damage 2 of 4&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2a78d6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="50" y="700" width="220" height="80" as="geometry"/></mxCell><mxCell id="state_graph-33" value="&lt;b style=&quot;font-size:14px&quot;&gt;Unit B&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;trait A · exhausted&lt;br&gt;damage 1 of 3&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2a78d6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="330" y="700" width="220" height="80" as="geometry"/></mxCell><mxCell id="state_graph-34" value="&lt;b style=&quot;font-size:14px&quot;&gt;Unit C&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;trait B · ready · fresh&lt;br&gt;(not matched: not trait A)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2a78d6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="610" y="700" width="220" height="80" as="geometry"/></mxCell><mxCell id="state_graph-35" value="Opponent’s play area" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fdece5;strokeColor=#eb6834;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontFamily=Helvetica;fontSize=15;fontStyle=1;fontColor=#1f1f1e;" vertex="1" parent="1"><mxGeometry x="900" y="640" width="780" height="190" as="geometry"/></mxCell><mxCell id="state_graph-36" value="&lt;b style=&quot;font-size:14px&quot;&gt;Unit X&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;ready · damage 0 of 5&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#eb6834;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="930" y="700" width="220" height="80" as="geometry"/></mxCell><mxCell id="state_graph-37" value="&lt;b style=&quot;font-size:14px&quot;&gt;Unit Y&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;exhausted · damage 3 of 4&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#eb6834;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="1210" y="700" width="220" height="80" as="geometry"/></mxCell><mxCell id="state_graph-38" value="&lt;b style=&quot;font-size:14px&quot;&gt;Site S&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;health 7 · 1 VP at start of turn&lt;br&gt;move cost 2&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#eb6834;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="1470" y="700" width="190" height="80" as="geometry"/></mxCell><mxCell id="state_graph-39" value="at_site" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#55554f;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="state_graph-36" target="state_graph-38"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1040" y="810"/><mxPoint x="1565" y="810"/></Array></mxGeometry></mxCell><mxCell id="state_graph-40" value="matches" style="html=1;strokeColor=#d6455d;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="state_graph-11" target="state_graph-36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="state_graph-41" value="matches" style="html=1;strokeColor=#d6455d;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="state_graph-11" target="state_graph-37"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="state_graph-42" value="matches" style="html=1;strokeColor=#d6455d;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="state_graph-23" target="state_graph-32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="state_graph-43" value="matches" style="html=1;strokeColor=#d6455d;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="state_graph-23" target="state_graph-33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="state_graph-44" value="affects" style="html=1;strokeColor=#d6455d;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6b6b66;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="state_graph-30" target="state_graph-37"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="state_graph-45" value="&lt;b style=&quot;font-size:14px&quot;&gt;Node features&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;&lt;div style='text-align:left'&gt;• &lt;b&gt;Card instance&lt;/b&gt;: card embedding (from the card encoder) + zone, exhausted, damage, fresh, site&lt;br&gt;• &lt;b&gt;Ability nodes&lt;/b&gt;: node type + parameters (amount, count, stat, keyword, duration, chooser)&lt;br&gt;• &lt;b&gt;Player / global&lt;/b&gt;: VP, energy ready and total, hand and deck size, added energy this turn, turn, phase&lt;br&gt;• &lt;b&gt;Active effect&lt;/b&gt;: effect type + parameters + turns until it expires&lt;/div&gt;&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a8a85;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="860" width="840" height="120" as="geometry"/></mxCell><mxCell id="state_graph-46" value="&lt;b style=&quot;font-size:14px&quot;&gt;Edges&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6b6b66&quot;&gt;&lt;div style='text-align:left'&gt;• &lt;b&gt;Grey, solid&lt;/b&gt;: structure of each card’s abilities; rebuilt only when a card changes zone&lt;br&gt;• &lt;b style='color:#d6455d'&gt;Red, dashed&lt;/b&gt;: computed by the engine at every decision. A filter is linked to each card it&lt;br&gt;&amp;nbsp;&amp;nbsp;currently matches, so the network sees exactly which cards an ability can affect&lt;br&gt;• Zone, owner and player-to-card edges are left out of this picture for clarity&lt;/div&gt;&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a8a85;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1f1f1e;spacing=6;align=left;" vertex="1" parent="1"><mxGeometry x="900" y="860" width="780" height="120" as="geometry"/></mxCell><mxCell id="state_graph-47" value="All game terms are placeholders until the game has a name and theme." style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#6b6b66;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="20" y="990" width="1660" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>